* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ico binary
*.png binary
*.exe binary
*.dll binary
*.sup binary
# 测试 fixture 必须字节固定：round-trip 断言不能被 checkout 的行尾转换改变
tests/fixtures/** -text
**/tests/fixtures/** -text
*.ass -text
*.srt -text
*.sup -text
*.bdn.xml -text
# 运行库配置按原始字节锁定 SHA-256，禁止 Git 改写行尾。
third_party/etc/fonts/** -text
third_party/share/fontconfig/** -text
